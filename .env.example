# Интеграция WordPress → EspoCRM.
# Скопируйте в .env и подставьте значения.

# Адрес API CRM.
# Локально: http://host.docker.internal:8080/api/v1
# Боевой:   https://crm.minka-furs.com/api/v1
MINKA_ESPO_API_URL=http://host.docker.internal:8080/api/v1
# Администрирование → Пользователи API → wp-integration
MINKA_ESPO_API_KEY=

# Секретные ключи вебхуков EspoCRM через запятую.
# Администрирование → Вебхуки → карточка вебхука → Secret Key.
# Нужны для проверки подписи запросов на /wp-json/minka/v1/espo-webhook
MINKA_ESPO_WEBHOOK_SECRETS=

# --- Meta ---
# Без Pixel ID скрипт Pixel не подключается вовсе.
MINKA_META_PIXEL_ID=
# Токен Conversions API. Без него серверные события не отправляются.
MINKA_META_CAPI_TOKEN=
# Код тестового события — только для отладки в Events Manager, в бою пустой.
MINKA_META_TEST_EVENT_CODE=
# Версия Graph API. По умолчанию v26.0.
MINKA_META_GRAPH_VERSION=

# Требовать маркетинговое согласие для серверных событий.
# По умолчанию требуется. Поставить 0 — осознанное решение владельца:
# события начнут уходить и по тем, кто отказал в маркетинге.
MINKA_CAPI_REQUIRE_MARKETING_CONSENT=1

# --- Telegram: оповещения о новых лидах ---
# Адрес CRM для ссылки в сообщении (по ней ходит человек, не сервер).
# Боевой: https://crm.minka-furs.com
MINKA_ESPO_UI_URL=http://localhost:8080
# Токен бота от @BotFather
MINKA_TG_BOT_TOKEN=
# ID группы, куда писать. Для групп он отрицательный: -1001234567890
MINKA_TG_CHAT_ID=
# Необязательно: id темы в группе с включёнными темами
MINKA_TG_THREAD_ID=
